# Copy to .env (gitignored) in the project root. Values here never override
# variables already exported in your shell.

# Anthropic API — needed for model = "anthropic[:<model>]"
ANTHROPIC_API_KEY=

# Local Ollama server — needed for model = "ollama:<model>"
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: sent by `oknoll build` for GitHub sources (rate limits, private repos)
# GITHUB_TOKEN=
