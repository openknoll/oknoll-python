# Copy to .env (gitignored) in the project root, or to ~/.oknoll/.env to share
# the secrets across every bundle on this machine. Values never override
# variables already exported in your shell, and a project .env beats ~/.oknoll/.env.

# Anthropic API — needed for model = "anthropic[:<model>]"
ANTHROPIC_API_KEY=

# Local Ollama server — needed for model = "ollama:<model>"
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: sent by `oknoll build` for GitHub sources (rate limits, private repos)
# GITHUB_TOKEN=
